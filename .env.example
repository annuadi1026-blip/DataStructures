# ---------- Backend (backend/.env or repo-root .env) ----------
NODE_ENV=development
PORT=5000

# PostgreSQL connection string. Local example below; for Supabase use the *Session pooler* string
# (Project > Connect) and replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://dsa:dsa@localhost:5432/dsa_squad
# Force TLS on/off. Leave blank for auto (TLS for anything that is not localhost).
DATABASE_SSL=
# Throw-away database used ONLY by `npm test` (its name must contain "test"; tests wipe it).
TEST_DATABASE_URL=postgresql://dsa:dsa@localhost:5432/dsa_squad_test

# Long random string (>= 32 chars in production). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Allowed browser origin(s) for CORS, comma separated, no trailing slash.
FRONTEND_URL=http://localhost:5173

# "Today" is computed in this IANA timezone.
APP_TIMEZONE=Asia/Kolkata
# Revision schedule: days after solving, then after each completed revision.
REVISION_INTERVALS_DAYS=1,3,7,21

# Scheduler
CRON_SECRET=
REMINDER_HOUR=18
SUMMARY_HOUR=21
NUDGE_COOLDOWN_MINUTES=180
NUDGE_DAILY_LIMIT=10

# Optional email delivery (in-app notifications work without it). Supported provider: resend
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=DSA Squad <onboarding@resend.dev>

# ---------- Frontend (frontend/.env; Vite exposes ONLY VITE_* to the browser, never put secrets here) ----------
VITE_API_URL=http://localhost:5000
